{
  "schema": 1,
  "repository": "closure-labs/finite",
  "actions": {
    "enabled": true,
    "allowed_actions": "all",
    "sha_pinning_required": false,
    "selected_actions": {
      "github_owned_allowed": true,
      "verified_allowed": true,
      "patterns_allowed": []
    },
    "workflow_permissions": {
      "default_workflow_permissions": "read",
      "can_approve_pull_request_reviews": true
    }
