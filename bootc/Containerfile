ARG BASE_REF

FROM ${BASE_REF}

ARG BASE_REF
ARG BUILD_PROFILE=bluefin-generic
ARG PURPLEFIN_VERSION=0.0.0-dev

LABEL org.opencontainers.image.title="Purplefin" \
      org.opencontainers.image.description="Bluefin foundation images with Nix Home Manager role profiles" \
      org.opencontainers.image.vendor="declarative-dale" \
      org.opencontainers.image.source="https://github.com/declarative-dale/purplefin" \
      org.opencontainers.image.base.name="${BASE_REF}" \
      org.opencontainers.image.version="${PURPLEFIN_VERSION}"

COPY bootc/ /tmp/purplefin-build/bootc/
COPY modules/aspects/ /tmp/purplefin-build/modules/aspects/

RUN --mount=type=bind,from=purplefin-generated,source=.,target=/run/purplefin-generated \
    PURPLEFIN_GENERATED_ROOT=/run/purplefin-generated \
    PURPLEFIN_VERSION="${PURPLEFIN_VERSION}" \
    /tmp/purplefin-build/bootc/builder/full.sh "${BUILD_PROFILE}" && \
    rm -rf /tmp/purplefin-build && \
    bootc container lint && \
    ostree container commit
