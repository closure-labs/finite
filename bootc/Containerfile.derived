ARG BASE_REF

FROM ${BASE_REF}

ARG BASE_REF
ARG BUILD_PROFILE
ARG PARENT_PROFILE
ARG FINITE_VERSION=0.0.0-dev

LABEL org.opencontainers.image.title="Finite" \
      org.opencontainers.image.description="A custom Bluefin image with composable named profiles" \
      org.opencontainers.image.vendor="Closure Labs" \
      org.opencontainers.image.source="https://github.com/closure-labs/finite" \
      org.opencontainers.image.base.name="${BASE_REF}" \
      org.opencontainers.image.version="${FINITE_VERSION}"

COPY bootc/ /tmp/finite-build/bootc/
COPY modules/aspects/ /tmp/finite-build/modules/aspects/

RUN --mount=type=bind,from=finite-generated,source=.,target=/run/finite-generated \
    FINITE_GENERATED_ROOT=/run/finite-generated \
    FINITE_VERSION="${FINITE_VERSION}" \
    /tmp/finite-build/bootc/builder/derived.sh "${BUILD_PROFILE}" "${PARENT_PROFILE}" && \
    rm -rf /tmp/finite-build && \
    bootc container lint && \
    ostree container commit
