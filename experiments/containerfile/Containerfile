# Universal Blue's context-stage pattern, without executing BlueBuild modules.
# Values come only from prepare.py after recipe, publisher and payload checks.
ARG BASE_IMAGE
ARG COSIGN_IMAGE
ARG BLUEBUILD_IMAGE
FROM ${COSIGN_IMAGE} AS cosign
FROM ${BLUEBUILD_IMAGE} AS bluebuild
FROM scratch AS ctx
COPY files /files
COPY experiments/containerfile /experiment
COPY scripts/bluebuild/verify-image.sh /verify-image.sh
COPY cosign.pub /cosign.pub
COPY .bluebuild/containerfile/plan.json /plan.json
FROM ${BASE_IMAGE}
ARG PROFILE
ARG FOUNDATION
ARG BASE_IMAGE
ARG SOURCE_REVISION
ARG BASE_DIGEST
ARG REFERENCE_IDENTITY
ARG EXPERIMENT_IDENTITY
ARG CREATED
ARG VERSION
ARG DESCRIPTION
ARG URL
COPY --from=cosign /ko-app/cosign /usr/bin/cosign
# Retain the installed CLI for user-visible parity; it does not build this image.
COPY --from=bluebuild /out/bluebuild /usr/bin/bluebuild
RUN --mount=type=bind,from=ctx,source=/,target=/ctx \
    /bin/bash /ctx/experiment/build.sh
LABEL org.opencontainers.image.title="Finite Containerfile experiment" \
      org.opencontainers.image.created="${CREATED}" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.description="${DESCRIPTION}" \
      org.opencontainers.image.url="${URL}" \
      org.opencontainers.image.vendor="Closure Labs" \
      org.opencontainers.image.source="https://github.com/closure-labs/finite" \
      org.opencontainers.image.revision="${SOURCE_REVISION}" \
      org.opencontainers.image.base.digest="${BASE_DIGEST}" \
      org.opencontainers.image.base.name="ghcr.io/ublue-os/${FOUNDATION}" \
      io.finite.foundation="${FOUNDATION}" \
      io.finite.profile="${PROFILE}" \
      io.finite.hardware="generic-x86_64" \
      io.finite.build-inputs="${EXPERIMENT_IDENTITY}" \
      io.finite.reference-build-inputs="${REFERENCE_IDENTITY}" \
      io.finite.experimental="containerfile-v1" \
      io.finite.production-eligible="false"
