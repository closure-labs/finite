+def test_resume_after_complete_body():
+    for unit in ("bytes", "bYtEs"):
+        set_unsatisfied_range(f"{unit} */{len(PAYLOAD)}")
+        rc, out, _ = fetch(path="unterminated")
+        assert rc == 0, f"Expected complete body success: {out}"
+        assert out.startswith(payload_hash() + "\n"), f"Unexpected hash: {out}"
+        assert range_requests == [f"bytes={len(PAYLOAD)}-"], f"Unexpected ranges: {range_requests}"
+
+
+def test_resume_after_complete_body_invalid_range():
+    for value in (f"bytes */{len(PAYLOAD)-1}", f"bytes */{len(PAYLOAD)+1}", None,
+                  "bytes */invalid", "bytes */", f"bytes */+{len(PAYLOAD)}",
+                  f"bytes */-{len(PAYLOAD)}", f"bytes */{len(PAYLOAD)}x", "bytes */9223372036854775808"):
+        set_unsatisfied_range(value)
+        rc, out, _ = fetch(path="unterminated")
+        assert rc != 0 and "HTTP error 416" in out, f"Invalid Content-Range accepted: {value!r}: {out}"
+        assert range_requests == [f"bytes={len(PAYLOAD)}-"], f"Unexpected ranges: {range_requests}"
