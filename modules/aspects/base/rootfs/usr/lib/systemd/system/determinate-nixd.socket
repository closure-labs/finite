[Unit]
Description=Determinate Nixd Daemon Socket
# See nix-daemon.socket: bootc provisions the persistent /nix backing tree
# after basic.target, so these sockets intentionally join the later boot phase.
DefaultDependencies=no
After=basic.target finite-nix-socket-cleanup.service
Before=nix-daemon.service multi-user.target shutdown.target
Conflicts=shutdown.target
RequiresMountsFor=/nix/store /nix/var/determinate
Requires=finite-nix-socket-cleanup.service

[Socket]
FileDescriptorName=determinate-nixd.socket
DirectoryMode=0755
ListenStream=/nix/var/determinate/determinate-nixd.socket
Service=nix-daemon.service
RemoveOnStop=true

[Install]
WantedBy=multi-user.target
