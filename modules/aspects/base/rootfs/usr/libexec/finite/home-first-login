#!/usr/bin/env bash
set -euo pipefail

profile="${FINITE_HOME_PROFILE_PATH:-$HOME/.config/finite/profile.json}"
home_flake="${FINITE_HOME_FLAKE_PATH:-$HOME/.config/home-manager}"
home_template="${FINITE_HOME_TEMPLATE_PATH:-/usr/share/finite/home-manager-template}"
running="${FINITE_RUNNING_PROFILE_PATH:-/usr/share/finite/profile.json}"
seed="${FINITE_PROVISIONED_PROFILE_PATH:-/etc/finite/home-profiles/$(id -un).yaml}"
nix="${FINITE_NIX_COMMAND:-/nix/var/nix/profiles/default/bin/nix}"
nix_wait_seconds="${FINITE_NIX_WAIT_SECONDS:-120}"
home_init="${FINITE_HOME_INIT_COMMAND:-/usr/libexec/finite/home-init}"

current=true
for required in customize.nix flake.nix flake.lock finite-template.json profile.json modules/finite.nix; do
	[[ -e "$home_flake/$required" ]] || current=false
done
if [[ "$current" == true ]] &&
	cmp -s "$home_flake/finite-template.json" "$home_template/finite-template.json" &&
	jq -e '.schema == 1 and .generator == "finite-home-init"' "$home_flake/finite-template.json" >/dev/null 2>&1 &&
	jq -e '[.nodes[].locked? | select(. != null) | .type] | all(. != "path")' "$home_flake/flake.lock" >/dev/null 2>&1 &&
	jq -e '
    .schema == 2 and
    (.foundation == "bluefin" or .foundation == "bluefin-dx") and
    (.hardware == "generic-x86_64" or .hardware == "dell-xps-9350-intel") and
    (.packages | type == "array") and
    all(.packages[]; . == "hack-font" or . == "herdr" or . == "jj" or
      . == "opencode" or . == "uv") and
    ((.packages | unique | length) == (.packages | length)) and
    (.roles | type == "array") and
    all(.roles[]; . == "developer" or . == "sales" or . == "trainer" or
      . == "support" or . == "executive" or . == "it") and
    ((.roles | unique | length) == (.roles | length)) and
    (.identity | type == "object")
  ' "$home_flake/profile.json" >/dev/null 2>&1; then
	exit 0
fi
[[ "$nix_wait_seconds" =~ ^[0-9]+$ ]] || {
	echo "Invalid Finite Nix wait timeout: $nix_wait_seconds" >&2
	exit 2
}

show_error() {
	status=$?
	trap - ERR
	message="Finite could not configure your Home Manager environment. Details are in the user journal; Finite will try again at the next graphical login."
	printf '%s\n' "$message" >&2
	zenity --error --title='Finite configuration failed' --text="$message" || true
	exit "$status"
}
trap show_error ERR

nix_deadline=$((SECONDS + nix_wait_seconds))
until [[ -x "$nix" ]] &&
	systemctl is-active --quiet nix-daemon.socket determinate-nixd.socket; do
	if ((SECONDS >= nix_deadline)); then
		echo "Finite Nix did not become ready within ${nix_wait_seconds}s: $nix" >&2
		false
	fi
	sleep 1
done
[[ -r "$running" ]] || { echo "Finite profile metadata is unavailable: $running" >&2; false; }

if [[ -r "$seed" ]]; then
	FINITE_NIX_COMMAND="$nix" "$home_init" --profile "$seed"
	exit 0
fi

if [[ -r "$profile" ]] && jq -e '
  ((.schema == 1 and (.packages? == null)) or
    (.schema == 2 and (.packages | type == "array") and
      all(.packages[]; . == "hack-font" or . == "herdr" or . == "jj" or
        . == "opencode" or . == "uv") and
      ((.packages | unique | length) == (.packages | length)))) and
  (.foundation == "bluefin" or .foundation == "bluefin-dx") and
  (.hardware == "generic-x86_64" or .hardware == "dell-xps-9350-intel") and
  (.roles | type == "array") and
  all(.roles[]; . == "developer" or . == "sales" or . == "trainer" or
    . == "support" or . == "executive" or . == "it")
' "$profile" >/dev/null 2>&1; then
	FINITE_NIX_COMMAND="$nix" "$home_init" --profile "$profile"
	exit 0
fi

foundation=$(jq -er '.foundation' "$running")
image_hardware=$(jq -er '.hardware' "$running")
hardware=generic-x86_64
dmi_root="${FINITE_DMI_ROOT:-/sys/class/dmi/id}"
if [[ -r "${dmi_root}/sys_vendor" && -r "${dmi_root}/product_name" ]] &&
	[[ "$(<"${dmi_root}/sys_vendor")" == "Dell Inc." ]] &&
	[[ "$(<"${dmi_root}/product_name")" == "XPS 13 9350" ]]; then
	hardware=dell-xps-9350-intel
fi
case "${image_hardware}" in
	generic-x86_64 | next-x86_64) ;;
	*) echo "Unsupported Finite image hardware: ${image_hardware}" >&2; false ;;
esac
if ! roles=$(zenity --list --checklist \
	--title='Configure Finite' \
	--text='Select any roles for your Home Manager environment. Leaving every role unchecked installs the base environment.' \
	--column='Use' --column='Role' --column='id' --hide-column=3 --print-column=3 --separator=, \
	FALSE Developer developer \
	FALSE Sales sales \
	FALSE Trainer trainer \
	FALSE Support support \
	FALSE Executive executive \
	FALSE IT it); then
	trap - ERR
	exit 0
fi

generated=$(mktemp)
trap 'rm -f -- "$generated"' EXIT
jq -n \
	--arg foundation "$foundation" \
	--arg hardware "$hardware" \
	--arg roles "$roles" \
	'{schema: 2, foundation: $foundation, hardware: $hardware, packages: [],
    roles: (if $roles == "" then [] else ($roles | split(",")) end), identity: {}}' \
	>"$generated"
FINITE_NIX_COMMAND="$nix" "$home_init" --profile "$generated"
