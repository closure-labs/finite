#!/usr/bin/env bash
set -euo pipefail

profile_file=""
activate=true
while (($# > 0)); do
	case "$1" in
	--profile)
		profile_file="${2:?--profile requires a value}"
		shift 2
		;;
	--check)
		activate=false
		shift
		;;
	*)
		echo "usage: finite-home-init --profile PROFILE [--check]" >&2
		exit 2
		;;
	esac
done
[[ -r "$profile_file" ]] || {
	echo "A readable --profile is required" >&2
	exit 2
}

username=$(id -un)
passwd_entry=$(getent passwd "$username")
home_directory=$(cut -d: -f6 <<<"$passwd_entry")
[[ "$username" =~ ^[a-z_][a-z0-9_-]*[$]?$ && "$home_directory" == /* ]] || {
	echo "Unable to discover a valid local account identity" >&2
	exit 2
}

config_parent="${XDG_CONFIG_HOME:-$home_directory/.config}"
template="${FINITE_HOME_TEMPLATE_PATH:-/usr/share/finite/home-manager-template}"
catalog="${FINITE_HOME_CATALOG_PATH:-/usr/share/finite/home-profile-catalog.json}"
running="${FINITE_RUNNING_PROFILE_PATH:-/usr/share/finite/profile.json}"
nix_command="${FINITE_NIX_COMMAND:-nix}"
for required in customize.nix flake.nix flake.lock finite-template.json modules/finite.nix; do
	[[ -e "$template/$required" ]] || {
		echo "Finite Home Manager template is incomplete: $template/$required" >&2
		exit 2
	}
done
[[ -r "$catalog" ]] || {
	echo "Finite Home Manager catalog is unavailable: $catalog" >&2
	exit 2
}

install -d -m 0700 "$config_parent"
workdir=$(mktemp -d "$config_parent/.finite-home-init.XXXXXX")
trap 'rm -rf -- "$workdir"' EXIT
cp -a -- "$template/." "$workdir/"
chmod -R u+w "$workdir"
yq -o=json '.' "$profile_file" >"$workdir/.input.json" || {
	echo "Malformed Finite profile: $profile_file" >&2
	exit 2
}
jq -e '
  type == "object" and
  (((.schema == 1) and
    ((keys | sort) == ["foundation", "hardware", "identity", "roles", "schema"])) or
   ((.schema == 2) and
    ((keys | sort) == ["foundation", "hardware", "identity", "packages", "roles", "schema"]))) and
  (.foundation | type == "string") and
  (.hardware | type == "string") and
  (.roles | type == "array") and all(.roles[]; type == "string") and
  ((.packages // []) | type == "array") and all((.packages // [])[]; type == "string") and
  (.identity | type == "object") and
  ((.identity | keys) - ["homeDirectory", "username"] | length == 0)
' "$workdir/.input.json" >/dev/null || {
	echo "Profile does not match a supported Finite schema" >&2
	exit 2
}

foundation=$(jq -er '.foundation' "$workdir/.input.json")
hardware=$(jq -er '.hardware' "$workdir/.input.json")
roles=$(jq -c '.roles' "$workdir/.input.json")
if [[ "$(jq -r '.schema' "$workdir/.input.json")" == 1 ]]; then
	packages='[]'
else
	packages=$(jq -c '.packages' "$workdir/.input.json")
fi
jq -e --arg foundation "$foundation" --arg hardware "$hardware" \
	--argjson packages "$packages" --argjson roles "$roles" '
  (.foundations[$foundation].hardware | index($hardware) != null) and
  (. as $catalog | all($packages[]; $catalog.packages[.] != null)) and
  (($packages | unique | length) == ($packages | length)) and
  (. as $catalog | all($roles[]; $catalog.roles[.] != null)) and
  (($roles | unique | length) == ($roles | length))
' "$catalog" >/dev/null || {
	echo "Profile contains an unknown or incompatible foundation, hardware profile, package, or role" >&2
	exit 2
}
canonical=$(jq -c --argjson requested "$roles" '
  [.roles | to_entries | sort_by(.value.order)[] | .key |
    select(. as $role | $requested | index($role) != null)]
' "$catalog")
canonical_packages=$(jq -c --argjson requested "$packages" '
  [.packages | to_entries | sort_by(.value.order)[] | .key |
    select(. as $package | $requested | index($package) != null)]
' "$catalog")

supplied_username=$(jq -r '.identity.username // empty' "$workdir/.input.json")
supplied_home=$(jq -r '.identity.homeDirectory // empty' "$workdir/.input.json")
[[ -z "$supplied_username" || "$supplied_username" == "$username" ]] || {
	echo "Profile identity username does not match the current account" >&2
	exit 2
}
[[ -z "$supplied_home" || "$supplied_home" == "$home_directory" ]] || {
	echo "Profile identity homeDirectory does not match the account database" >&2
	exit 2
}

if [[ -r "$running" && "${FINITE_SKIP_FOUNDATION_CHECK:-false}" != true ]]; then
	running_foundation=$(jq -er '.foundation' "$running")
	running_hardware=$(jq -er '.hardware' "$running")
	if [[ "$foundation" != "$running_foundation" ]] ||
		! jq -e --arg hardware "$hardware" --arg image_hardware "$running_hardware" '
          .hardware[$hardware].imageHardware | index($image_hardware) != null
        ' "$catalog" >/dev/null; then
		echo "Profile $foundation/$hardware is incompatible with running Finite image $running_foundation/$running_hardware" >&2
		exit 2
	fi
fi

jq -n \
	--arg foundation "$foundation" --arg hardware "$hardware" \
	--arg username "$username" --arg home "$home_directory" \
	--argjson packages "$canonical_packages" \
	--argjson roles "$canonical" \
	'{schema: 2, foundation: $foundation, hardware: $hardware, packages: $packages, roles: $roles,
    identity: {username: $username, homeDirectory: $home}}' \
	>"$workdir/profile.json"
rm -f -- "$workdir/.input.json"

hm_dir="$config_parent/home-manager"
preserve_customization() {
	relative_path="${1:?relative customization path is required}"
	source_path="$hm_dir/$relative_path"
	[[ -e "$source_path" || -L "$source_path" ]] || return 0
	[[ -f "$source_path" && ! -L "$source_path" ]] || {
		echo "Refusing to preserve non-regular customization: $source_path" >&2
		exit 2
	}
	install -m 0600 "$source_path" "$workdir/$relative_path"
}
preserve_customization customize.nix
preserve_customization modules/local.nix

jq -e '.schema == 1 and .generator == "finite-home-init"' \
	"$workdir/finite-template.json" >/dev/null || {
	echo "Finite Home Manager template has an unsupported scaffold" >&2
	exit 2
}
jq -e '[.nodes[].locked? | select(. != null) | .type] | all(. != "path")' \
	"$workdir/flake.lock" >/dev/null || {
	echo "Finite Home Manager lock contains a forbidden local path input" >&2
	exit 2
}

activation=$(
	"$nix_command" --accept-flake-config build \
		--no-update-lock-file \
		"path:$workdir#homeConfigurations.${username}.activationPackage" \
		--no-link --print-build-logs --print-out-paths
)
printf 'Finite Home Manager configuration for %s builds as %s\n' "$username" "$activation"
[[ "$activate" == false ]] && exit 0

backup=""
if [[ -e "$hm_dir" || -L "$hm_dir" ]]; then
	backup="$config_parent/home-manager.previous.$(date -u +%Y%m%dT%H%M%SZ).$$"
	mv -- "$hm_dir" "$backup"
fi
if ! mv -- "$workdir" "$hm_dir"; then
	[[ -z "$backup" ]] || mv -- "$backup" "$hm_dir"
	exit 1
fi
trap - EXIT
find "$hm_dir" -type d -exec chmod 0700 {} +
find "$hm_dir" -type f -exec chmod 0600 {} +

finite_dir="$config_parent/finite"
install -d -m 0700 "$finite_dir"
install -m 0600 "$hm_dir/profile.json" "$finite_dir/.profile.json.new"
mv -f "$finite_dir/.profile.json.new" "$finite_dir/profile.json"
[[ -z "$backup" ]] || printf 'Previous Home Manager configuration saved as %s\n' "$backup"
exec "$activation/activate"
