#!/usr/bin/env bash
set -euo pipefail

unit=finite-caffeinate.service

case "${1:-status}" in
	on)
		systemctl --user start "${unit}"
		echo 'Finite caffeine inhibitor enabled; lid-close sleep is blocked.'
		;;
	off)
		systemctl --user stop "${unit}"
		echo 'Finite caffeine inhibitor disabled; normal lid behavior is restored.'
		;;
	status)
		systemctl --user --no-pager status "${unit}"
		;;
	*)
		echo 'usage: finite-caffeinate {on|off|status}' >&2
		exit 2
		;;
esac
