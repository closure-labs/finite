ARG BASE_REF=quay.io/fedora/fedora-bootc:44
FROM ${BASE_REF}

# This follows image-builder's supported bootc-generic-iso contract. The
# Fedora bootc is only the live Anaconda environment. Finite is supplied
# separately to Image Builder as the installed payload, keeping its desktop and
# developer packages out of the squashfs that must be rebuilt for every ISO.
# Keep the expensive package installation independent of the payload reference
# so the registry layer cache can reuse it when only Finite changes.
RUN dnf5 -y install \
      anaconda anaconda-install-img-deps anaconda-dracut \
      dracut-config-generic dracut-network net-tools \
      grub2-efi-x64-cdboot grub2-pc-modules grub2-tools-extra \
      patch \
      plymouth default-fonts-core-sans default-fonts-other-sans \
      google-noto-sans-cjk-fonts isomd5sum squashfs-tools xorriso && \
    dnf5 clean all && \
    mkdir -p /boot/efi /var/mnt && \
    cp -ra /usr/lib/efi/*/*/EFI /boot/efi && \
    echo 'install:x:0:0:root:/root:/usr/libexec/anaconda/run-anaconda' >>/etc/passwd && \
    echo 'install::14438:0:99999:7:::' >>/etc/shadow && \
    passwd -d root && \
    mv /usr/share/anaconda/list-harddrives-stub /usr/bin/list-harddrives && \
    mv /etc/yum.repos.d /etc/anaconda.repos.d && \
    ln -sf /usr/lib/systemd/system/anaconda.target /etc/systemd/system/default.target && \
    rm -f /usr/lib/systemd/system-generators/systemd-gpt-auto-generator && \
    ln -sf /usr/lib/systemd/system/anaconda-shell@.service /usr/lib/systemd/system/autovt@.service && \
    mkdir -p "$(realpath /root)"

# Fedora 44 Anaconda deploys the bootc payload but tears its target mounts down
# without the final bootc phase. Backport the accepted upstream lifecycle shape
# so bootupd finishes the ESP, including the portable EFI/BOOT fallback, before
# those mounts disappear. The locked Fedora base makes a rejected patch a hard
# build failure instead of silently carrying a stale workaround forward.
COPY patches/anaconda-finalize-bootc.patch /tmp/anaconda-finalize-bootc.patch
RUN site_packages="$(python3 -c \
      'from pathlib import Path; import pyanaconda; print(Path(pyanaconda.__file__).parent.parent)')" && \
    patch --batch --fuzz=0 --directory="${site_packages}" --strip=1 \
      </tmp/anaconda-finalize-bootc.patch && \
    python3 -m compileall -q \
      "${site_packages}/pyanaconda/modules/payloads/payload/rpm_ostree" && \
    rm -f /tmp/anaconda-finalize-bootc.patch

# Installer configuration changes rebuild dracut, but payload-only changes do
# not. The named context also prevents a broad COPY from invalidating the base.
ARG INSTALLER_CONTEXT_DIGEST
RUN --mount=from=installer-rootfs,target=/run/installer-rootfs \
    test -n "${INSTALLER_CONTEXT_DIGEST}" && \
    cp -a /run/installer-rootfs/. / && \
    kernel="$(kernel-install list --json pretty | jq -r '.[] | select(.has_kernel == true) | .version')" && \
    DRACUT_NO_XATTR=1 dracut --force --zstd --reproducible --no-hostonly \
      --add anaconda "/usr/lib/modules/${kernel}/initramfs.img" "${kernel}"

ARG INSTALLER_PAYLOAD_SOURCE_REF=ghcr.io/closure-labs/finite:bluefin-generic
ARG INSTALLER_PAYLOAD_TARGET_REF=ghcr.io/closure-labs/finite:bluefin-generic

RUN sed -i \
      -e "s|@@INSTALLER_PAYLOAD_SOURCE_REF@@|${INSTALLER_PAYLOAD_SOURCE_REF}|g" \
      -e "s|@@INSTALLER_PAYLOAD_TARGET_REF@@|${INSTALLER_PAYLOAD_TARGET_REF}|g" \
      /usr/share/anaconda/interactive-defaults.ks
