text --non-interactive
lang en_US.UTF-8
keyboard us
timezone Etc/UTC --utc
zerombr
clearpart --all --initlabel --disklabel=gpt
autopart --noswap --type=plain --fstype=ext4
network --bootproto=dhcp --device=link --activate --onboot=on
rootpw --lock
bootloader --append="console=tty0 console=ttyS0,115200n8"
reboot
bootc --source-imgref registry:@@INSTALLER_PAYLOAD_SOURCE_REF@@ --target-imgref @@INSTALLER_PAYLOAD_TARGET_REF@@

%post --erroronfail
cat >/usr/local/libexec/finite-ci-installed-ready <<'FINITE_EOF'
#!/usr/bin/bash
set -euo pipefail

bootc="${FINITE_BOOTC:-/usr/bin/bootc}"
python="${FINITE_PYTHON:-/usr/bin/python3}"
console="${FINITE_CONSOLE:-/dev/console}"

if ! status="$("${bootc}" status --json --format-version=1)"; then
	printf 'FINITE_INSTALLED_ERROR=bootc-status-failed\n' >"${console}"
	exit 1
fi
printf 'FINITE_BOOTC_STATUS=%s\n' "${status}" >"${console}"

if ! observed="$("${python}" -c '
import json
import sys

image = json.load(sys.stdin)["status"]["booted"]["image"]
print(image["imageDigest"], image["image"]["image"], sep="\t")
' <<<"${status}")"; then
	printf 'FINITE_INSTALLED_ERROR=bootc-status-invalid\n' >>"${console}"
	exit 1
fi
IFS=$'\t' read -r booted_digest booted_reference <<<"${observed}"

printf 'FINITE_INSTALLED_DIGEST=%s\n' "${booted_digest}" >>"${console}"
printf 'FINITE_INSTALLED_REFERENCE=%s\n' "${booted_reference}" >>"${console}"
printf 'FINITE_EXPECTED_DIGEST=%s\n' '@@INSTALLER_PAYLOAD_DIGEST@@' >>"${console}"
printf 'FINITE_EXPECTED_REFERENCE=%s\n' '@@INSTALLER_UPDATE_REFERENCE@@' >>"${console}"
if [[ "${booted_digest}" != '@@INSTALLER_PAYLOAD_DIGEST@@' ]]; then
	printf 'FINITE_INSTALLED_ERROR=digest-mismatch\n' >>"${console}"
	exit 1
fi
if [[ "${booted_reference}" != '@@INSTALLER_UPDATE_REFERENCE@@' ]]; then
	printf 'FINITE_INSTALLED_ERROR=reference-mismatch\n' >>"${console}"
	exit 1
fi
printf 'FINITE_INSTALLED_READY=1\n' >>"${console}"
FINITE_EOF
chmod 0755 /usr/local/libexec/finite-ci-installed-ready
cat >/etc/systemd/system/finite-ci-installed-ready.service <<'FINITE_EOF'
[Unit]
Description=Finite installed-system CI readiness marker
After=systemd-user-sessions.service
Before=finite-firstboot-rpm-ostree.service

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/finite-ci-installed-ready
RemainAfterExit=yes
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target
FINITE_EOF
systemctl enable finite-ci-installed-ready.service
%end
