# Finite native installer media, built FROM the exact signed native payload so
# the live system runs the identical pinned bootc runtime and EFI updater.
# Packaged by osbuild image-builder generic-iso (see sources/native-installer.json).
ARG PAYLOAD
FROM ${PAYLOAD}
ARG PAYLOAD_REF
ARG PAYLOAD_DIGEST
ARG VALIDATION=false

# Live boot: dmsquash-live in the initramfs; Fedora-signed shim + cdboot GRUB
# for the ISO's own Secure Boot chain; ISO assembly tools used by image-builder.
RUN dnf -y install dracut-live grub2-efi-x64-cdboot grub2-pc-modules grub2-tools grub2-tools-extra \
        squashfs-tools xorriso isomd5sum skopeo podman \
    && dnf clean all

RUN set -eu; \
    kernels=$(find /kernel -mindepth 2 -maxdepth 2 -name vmlinuz | wc -l); \
    test "$kernels" -eq 1; \
    kver=$(basename "$(dirname "$(find /kernel -mindepth 2 -maxdepth 2 -name vmlinuz)")"); \
    sbverify --cert /usr/share/finite/secure-boot/finite-boot.pem "/boot/EFI/Linux/$kver.efi"; \
    test -s /usr/lib/finite/efi/manifest.json; \
    install -m644 "/kernel/$kver/vmlinuz" "/usr/lib/modules/$kver/vmlinuz"; \
    dracut --force --no-hostonly --reproducible --omit 'bootc ostree' --add dmsquash-live --kver "$kver" \
        "/usr/lib/modules/$kver/initramfs.img"; \
    lsinitrd "/usr/lib/modules/$kver/initramfs.img" | grep -q dmsquash-live; \
    mkdir -p /boot/efi; \
    cp -ra /usr/lib/efi/*/*/EFI /boot/efi; \
    test -s /boot/efi/EFI/fedora/shimx64.efi; \
    test -s /boot/efi/EFI/fedora/gcdx64.efi

COPY README.md /usr/share/doc/finite/native-installer.md
COPY finite-native-install /usr/libexec/finite/finite-native-install
COPY finite-native-installer.service /usr/lib/systemd/system/finite-native-installer.service
COPY iso.yaml /usr/lib/image-builder/bootc/iso.yaml
RUN set -eu; if [ "$VALIDATION" = true ]; then \
      printf "  - console=ttyS0,115200n8\n  - rd.plymouth=0\n  - plymouth.enable=0\n" >> /usr/lib/image-builder/bootc/iso.yaml; \
      sed -i -e 's|/dev/tty1|/dev/ttyS0|g' \
        -e 's|finite-native-install install$|finite-native-install install --no-recovery-key|' \
        /usr/lib/systemd/system/finite-native-installer.service; \
      systemctl mask serial-getty@ttyS0.service; \
    fi

# Installed-system services make no sense on live media.
RUN systemctl enable finite-native-installer.service \
    && systemctl mask finite-efi-update.service bootloader-update.service rpm-ostreed.service \
        finite-firstboot-rpm-ostree.service

# Unpack the verified OCI layout into the ISO's live filesystem. Reading it as a
# directory lets preflight inspect the original manifest without RAM-backed unpacking.
# The live root may drop the RPM database, so pin the actual bootc runtime bytes.
RUN set -eu; \
    test -n "$PAYLOAD_REF"; \
    echo "$PAYLOAD_DIGEST" | grep -Eq '^sha256:[0-9a-f]{64}$'; \
    version=$(bootc --version | sed -n 's/^bootc //p'); \
    test -n "$version"; \
    directory=/usr/lib/finite/installer; \
    source="oci:$directory/payload"; \
    install -d -m0755 "$directory/payload"; \
    tar --no-same-owner --no-same-permissions -xf /run/finite-payload.oci.tar -C "$directory/payload"; \
    manifest_sha=$(skopeo inspect --raw "$source" | sha256sum | cut -d' ' -f1); \
    test "sha256:$manifest_sha" = "$PAYLOAD_DIGEST"; \
    runtime_sha=$(python3 -c 'import hashlib,json; from pathlib import Path; r=json.loads(Path("/usr/share/finite/bootc-runtime.json").read_text()); expected=r["files"]["/usr/bin/bootc"]; actual=hashlib.sha256(Path("/usr/bin/bootc").read_bytes()).hexdigest(); assert actual == expected, "live runtime differs from signed payload"; print(expected)'); \
    printf '{"schema": 3, "bootcVersion": "%s", "bootcSha256": "%s", "payloadDigest": "%s", "sourceImgref": "%s", "targetImgref": "%s"}\n' \
        "$version" "$runtime_sha" "$PAYLOAD_DIGEST" "$source" "$PAYLOAD_REF" > "$directory/pins.json"; \
    python3 -c 'import json; json.load(open("/usr/lib/finite/installer/pins.json"))'
