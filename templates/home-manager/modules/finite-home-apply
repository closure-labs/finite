set -euo pipefail

roles=""
packages=""
packages_set=false
activate=true
while (($# > 0)); do
  case "$1" in
    --roles) roles="${2:?--roles requires a value}"; shift 2 ;;
    --packages) packages="${2:?--packages requires a value}"; packages_set=true; shift 2 ;;
    --check) activate=false; shift ;;
    *) echo "usage: finite-home-apply --roles ROLE,... [--packages PACKAGE,...] [--check]" >&2; exit 2 ;;
  esac
done

username=$(id -un)
passwd_entry=$(getent passwd "$username")
home_directory=$(cut -d: -f6 <<<"$passwd_entry")
[[ "$username" =~ ^[a-z_][a-z0-9_-]*[$]?$ && "$home_directory" == /* ]] || {
  echo "Unable to discover a valid local account identity" >&2
  exit 2
}

config_parent="${XDG_CONFIG_HOME:-$home_directory/.config}"
flake_root="${FINITE_HOME_FLAKE_ROOT:-$config_parent/home-manager}"
profile="$flake_root/profile.json"
nix_command="${FINITE_NIX_COMMAND:-nix}"

for required in customize.nix flake.nix flake.lock finite-template.json profile.json modules/finite.nix; do
  [[ -e "$flake_root/$required" ]] || {
    echo "Finite Home Manager configuration is incomplete: $flake_root/$required" >&2
    exit 2
  }
done
jq -e '.schema == 1 and .generator == "finite-home-init"' \
  "$flake_root/finite-template.json" >/dev/null || {
  echo "Finite Home Manager configuration has an unsupported scaffold" >&2
  exit 2
}
jq -e 'all(.nodes[]; ((.locked.type? // "") != "path"))' \
  "$flake_root/flake.lock" >/dev/null || {
  echo "Finite Home Manager lock contains a forbidden local path input" >&2
  exit 2
}
jq -e --arg username "$username" --arg home "$home_directory" '
  .schema == 2 and
  (.foundation == "bluefin" or .foundation == "bluefin-dx") and
  (.hardware == "generic-x86_64" or .hardware == "dell-xps-9350-intel") and
  (.roles | type == "array") and all(.roles[]; type == "string") and
  (.packages | type == "array") and all(.packages[]; type == "string") and
  .identity == {username: $username, homeDirectory: $home}
' "$profile" >/dev/null || {
  echo "The installed Finite profile is invalid" >&2
  exit 2
}

requested='[]'
if [[ -n "$roles" ]]; then
  IFS=, read -ra role_list <<<"$roles"
  for role in "${role_list[@]}"; do
    case "$role" in
      developer|sales|trainer|support|executive|it) ;;
      *) echo "Unknown role: $role" >&2; exit 2 ;;
    esac
    if jq -e --arg role "$role" 'index($role) != null' <<<"$requested" >/dev/null; then
      echo "Duplicate role: $role" >&2
      exit 2
    fi
    requested=$(jq -c --arg role "$role" '. + [$role]' <<<"$requested")
  done
fi
canonical=$(jq -cn --argjson requested "$requested" '
  ["developer", "sales", "trainer", "support", "executive", "it"] |
  [.[] | select(. as $role | $requested | index($role) != null)]
')

if [[ "$packages_set" == false ]]; then
  packages=$(jq -r '.packages | join(",")' "$profile")
fi
requested_packages='[]'
if [[ -n "$packages" ]]; then
  IFS=, read -ra package_list <<<"$packages"
  for package in "${package_list[@]}"; do
    case "$package" in
      hack-font|herdr|jj|opencode|uv) ;;
      *) echo "Unknown package: $package" >&2; exit 2 ;;
    esac
    if jq -e --arg package "$package" 'index($package) != null' <<<"$requested_packages" >/dev/null; then
      echo "Duplicate package: $package" >&2
      exit 2
    fi
    requested_packages=$(jq -c --arg package "$package" '. + [$package]' <<<"$requested_packages")
  done
fi
canonical_packages=$(jq -cn --argjson requested "$requested_packages" '
  ["hack-font", "herdr", "jj", "opencode", "uv"] |
  [.[] | select(. as $package | $requested | index($package) != null)]
')

workdir=$(mktemp -d "$config_parent/.finite-home-apply.XXXXXX")
trap 'rm -rf -- "$workdir"' EXIT
cp -a -- "$flake_root/." "$workdir/"
jq --argjson packages "$canonical_packages" --argjson roles "$canonical" \
  '.schema = 2 | .packages = $packages | .roles = $roles' "$profile" >"$workdir/.profile.json.new"
mv -f "$workdir/.profile.json.new" "$workdir/profile.json"

activation=$(
  "$nix_command" --accept-flake-config build \
    --no-update-lock-file \
    "path:$workdir#homeConfigurations.${username}.activationPackage" \
    --no-link --print-build-logs --print-out-paths
)
printf 'Finite Home Manager configuration for %s builds as %s\n' "$username" "$activation"
[[ "$activate" == false ]] && exit 0

install -m 0600 "$workdir/profile.json" "$flake_root/.profile.json.new"
mv -f "$flake_root/.profile.json.new" "$flake_root/profile.json"
finite_dir="$config_parent/finite"
install -d -m 0700 "$finite_dir"
install -m 0600 "$workdir/profile.json" "$finite_dir/.profile.json.new"
mv -f "$finite_dir/.profile.json.new" "$finite_dir/profile.json"
exec "$activation/activate"
