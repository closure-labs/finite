# shellcheck shell=bash
set -euo pipefail

modules=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
brew_command="${FINITE_BREW_COMMAND:-/home/linuxbrew/.linuxbrew/bin/brew}"
export FINITE_BREW_POLICY="${FINITE_BREW_POLICY:-$modules/aspects/base/brew-packages.json}"
export HOMEBREW_NO_AUTO_UPDATE=1

if "$BASH" "$modules/finite-brew-migration-status" --check-installed >/dev/null; then
  exit 0
fi
[[ -x "$brew_command" ]] || {
  echo 'Homebrew must be initialized by Bluefin brew-setup.service before applying this profile.' >&2
  exit 1
}

brewfile=$(mktemp)
trap 'rm -f -- "$brewfile"' EXIT
jq -r '(.taps // [])[] | "tap " + tojson' "$FINITE_BREW_POLICY" >"$brewfile"
jq -r '.packages[] | "brew " + (.formula | tojson)' "$FINITE_BREW_POLICY" >>"$brewfile"
printf 'Installing the shared Homebrew CLI tools before activating Home Manager\n'
"$brew_command" bundle install --no-upgrade --file "$brewfile"
"$BASH" "$modules/finite-brew-migration-status" --check-installed
