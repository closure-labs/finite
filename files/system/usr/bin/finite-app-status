#!/usr/bin/python3
"""Compare user dependency pins with the running image's approved template."""
import argparse
import hashlib
import json
import os
from pathlib import Path
import subprocess
import sys


def read_lock(path):
    lock = json.loads(path.read_text())
    if lock.get("version") != 7 or not isinstance(lock.get("nodes"), dict):
        raise ValueError(f"Unsupported lock file: {path}")
    if not isinstance(lock["nodes"].get(lock.get("root")), dict):
        raise ValueError(f"Missing lock root: {path}")
    return lock


def resolve(lock, reference, following=()):
    if isinstance(reference, str):
        if reference not in lock["nodes"]:
            raise ValueError(f"Missing lock node: {reference}")
        return reference
    if not isinstance(reference, list) or not all(isinstance(x, str) for x in reference):
        raise ValueError("Invalid lock input reference")
    path = tuple(reference)
    if path in following:
        raise ValueError("Cyclic lock follows reference")
    node = lock["root"]
    for part in path:
        node = resolve(lock, lock["nodes"][node]["inputs"][part], (*following, path))
    return node


def graph(lock, reference, parents=()):
    node_id = resolve(lock, reference)
    if node_id in parents:
        return {"cycle": parents.index(node_id)}
    node = lock["nodes"][node_id]
    return {
        "locked": node.get("locked"),
        "flake": node.get("flake", True),
        "inputs": {
            name: graph(lock, child, (*parents, node_id))
            for name, child in sorted(node.get("inputs", {}).items())
        },
    }


def compare(approved, installed):
    expected = approved["nodes"][approved["root"]].get("inputs", {})
    actual = installed["nodes"][installed["root"]].get("inputs", {})
    result = {"current": [], "different": [], "missing": [], "custom": []}
    for name, reference in sorted(expected.items()):
        if name not in actual:
            result["missing"].append(name)
            continue
        desired = approved["nodes"][resolve(approved, reference)]
        user = installed["nodes"][resolve(installed, actual[name])]
        # A changed source/ref is an intentional custom input, not an update target.
        if user.get("original") != desired.get("original"):
            result["custom"].append(name)
        elif graph(approved, reference) == graph(installed, actual[name]):
            result["current"].append(name)
        else:
            result["different"].append(name)
    result["custom"].extend(sorted(set(actual) - set(expected)))
    return result


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--json", action="store_true", help="print machine-readable status")
    parser.add_argument("--notify", action="store_true", help="notify once per approved template; stores notification state")
    args = parser.parse_args()
    config = Path(os.environ.get("XDG_CONFIG_HOME", str(Path.home() / ".config")))
    installed = Path(os.environ.get("FINITE_HOME_FLAKE_PATH", str(config / "home-manager")))
    template = Path(os.environ.get("FINITE_HOME_TEMPLATE_PATH", "/usr/share/finite/home-manager-template"))
    try:
        approved_lock = read_lock(template / "flake.lock")
        result = compare(approved_lock, read_lock(installed / "flake.lock"))
        fingerprint = hashlib.sha256(
            json.dumps(approved_lock, sort_keys=True).encode()
            + (template / "finite-template.json").read_bytes()
        ).hexdigest()
        result["approved_template"] = fingerprint
        if args.json:
            print(json.dumps(result, sort_keys=True))
        else:
            for category in ("current", "different", "missing", "custom"):
                print(f"{category.capitalize()} inputs: {', '.join(result[category]) or 'none'}")
            if result["different"] or result["missing"]:
                print("Approved image pins differ. Review finite-app-status --json and the app-update guide before manually updating and building your configuration.")
        if args.notify and (result["different"] or result["missing"]):
            state = Path(os.environ.get("XDG_STATE_HOME", str(Path.home() / ".local/state"))) / "finite"
            marker = state / "app-update-notified"
            if marker.exists() and marker.read_text().strip() == fingerprint:
                return 0
            try:
                subprocess.run([
                    "notify-send", "Finite app updates available",
                    "Your app pins differ from this image's approved template. Run finite-app-status to review; updates require manual activation.",
                ], check=True, timeout=10)
            except (OSError, subprocess.CalledProcessError, subprocess.TimeoutExpired):
                return 0  # Retry next login if notifications are unavailable.
            state.mkdir(mode=0o700, parents=True, exist_ok=True)
            marker.write_text(fingerprint + "\n")
        return 0
    except (OSError, ValueError, KeyError, TypeError, RecursionError) as error:
        print(f"Cannot determine Finite app status: {error}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    sys.exit(main())
