#!/usr/bin/env bash
set -euo pipefail

policy=${FINITE_NIX_SELINUX_POLICY:-/usr/share/selinux/packages/determinate-nix.pp}
home_contexts=${FINITE_HOME_CONTEXTS_COMMAND:-/usr/libexec/finite/fix-home-selinux-contexts}
test -s "${policy}"
if ! semodule -l | awk '$1 == "nix" { found = 1 } END { exit !found }'; then
	semodule -i "${policy}"
fi

# semodule can regenerate /var/home rules while the old /var/home -> /home
# substitution remains. Correct it before adding a nested Nix equivalence;
# otherwise semanage rejects /var/home/nix as conflicting with that parent.
"$home_contexts"

# /nix is a bind mount backed by persistent state below /var/home. Teach the
# SELinux label lookup to treat that backing tree exactly like /nix before the
# seed service restores its contexts. Otherwise the home-directory rules win,
# including for the daemon sockets that systemd must be able to replace.
# add_equal already updates an existing local equivalence. Preserve any real
# add error instead of replacing it with a misleading failed modify operation.
semanage fcontext -a -e /nix /var/home/nix

# Policy transactions regenerate home rules using the OSTree useradd defaults.
"$home_contexts"
