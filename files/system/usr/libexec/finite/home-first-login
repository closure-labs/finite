#!/usr/bin/env bash
set -Eeuo pipefail

profile="${FINITE_HOME_PROFILE_PATH:-${XDG_CONFIG_HOME:-$HOME/.config}/finite/profile.json}"
home_flake="${FINITE_HOME_FLAKE_PATH:-${XDG_CONFIG_HOME:-$HOME/.config}/home-manager}"
running="${FINITE_RUNNING_PROFILE_PATH:-/usr/share/finite/profile.json}"
seed="${FINITE_PROVISIONED_PROFILE_PATH:-/etc/finite/home-profiles/$(id -un).yaml}"
nix="${FINITE_NIX_COMMAND:-/nix/var/nix/profiles/default/bin/nix}"
nix_wait_seconds="${FINITE_NIX_WAIT_SECONDS:-120}"
home_init="${FINITE_HOME_INIT_COMMAND:-/usr/libexec/finite/home-init}"
catalog="${FINITE_FOUNDATION_CATALOG:-/usr/share/finite/home-profile-catalog.json}"

# Existing configurations are user-owned. OS updates never refresh their modules.
# Legacy configurations remain usable until an explicit finite-home-migrate.
if [[ -r "$home_flake/flake.nix" && -r "$home_flake/flake.lock" && -r "$home_flake/profile.json" ]]; then
	exit 0
fi
[[ "$nix_wait_seconds" =~ ^[0-9]+$ ]] || {
	echo "Invalid Finite Nix wait timeout: $nix_wait_seconds" >&2
	exit 2
}

show_error() {
	status=$?
	trap - ERR
	message="Finite could not configure your Home Manager environment. Details are in the user journal; Finite will try again at the next graphical login."
	printf '%s\n' "$message" >&2
	zenity --error --title='Finite configuration failed' --text="$message" || true
	exit "$status"
}
trap show_error ERR

# A partial consumer is still user data; do not replace it from another source.
if [[ -e "$home_flake" || -L "$home_flake" ]]; then
	echo "Incomplete Home Manager configuration requires manual repair: $home_flake" >&2
	false
fi

nix_deadline=$((SECONDS + nix_wait_seconds))
until [[ -x "$nix" ]] &&
	systemctl is-active --quiet nix-daemon.socket &&
	systemctl is-active --quiet determinate-nixd.socket; do
	if ((SECONDS >= nix_deadline)); then
		echo "Finite Nix did not become ready within ${nix_wait_seconds}s: $nix" >&2
		false
	fi
	sleep 1
done
[[ -r "$running" ]] || { echo "Finite profile metadata is unavailable: $running" >&2; false; }

# Older helpers do not expose this query. They can initialize only schema 1/2.
# Variables inside this literal filter belong to jq, not Bash.
# shellcheck disable=SC2016
capability_filter='def valid_capabilities:
    .schema == 1 and
    all(.initializeSchemas, .normalizeSchemas, .catalogSchemas;
      type == "array" and length > 0 and
      all(.[]; type == "number" and . > 0 and floor == .) and
      (unique | length) == length) and
    (.writeSchema as $schema | (.initializeSchemas | index($schema)) != null and
      (.normalizeSchemas | index($schema)) != null);'
if capabilities=$(FINITE_NIX_COMMAND="$nix" "$home_init" --capabilities); then
	jq -e "$capability_filter valid_capabilities" <<<"$capabilities" >/dev/null || { echo "Invalid Home Manager helper capabilities" >&2; false; }
else
	capabilities='{"schema":1,"initializeSchemas":[1,2],"normalizeSchemas":[2],"writeSchema":2,"catalogSchemas":[3]}'
fi

initialize_profile() {
	local candidate="$1" schema
	# Check before invoking historical initializers that silently assign schema 2.
	schema=$(yq -o=json '.' "$candidate" | jq -er '.schema | select(type == "number" and . > 0 and floor == .)')
	jq -e --argjson schema "$schema" '.initializeSchemas | index($schema) != null' <<<"$capabilities" >/dev/null || {
		echo "Installed Home Manager helper cannot initialize profile schema $schema: $candidate" >&2
		return 2
	}
	FINITE_NIX_COMMAND="$nix" "$home_init" --profile "$candidate"
}

# A saved selection takes precedence over a provisioning seed. Any failure is
# reported; it never falls through to generating a replacement selection.
if [[ -e "$profile" || -L "$profile" ]]; then
	initialize_profile "$profile"
	exit 0
fi
if [[ -e "$seed" || -L "$seed" ]]; then
	initialize_profile "$seed"
	exit 0
fi

foundation=$(jq -er '.foundation' "$running")
image_hardware=$(jq -er '.hardware' "$running")
hardware=generic-x86_64
dmi_root="${FINITE_DMI_ROOT:-/sys/class/dmi/id}"
if [[ -r "${dmi_root}/sys_vendor" && -r "${dmi_root}/product_name" ]] &&
	[[ "$(<"${dmi_root}/sys_vendor")" == "Dell Inc." ]] &&
	[[ "$(<"${dmi_root}/product_name")" == "XPS 13 9350" ]]; then
	hardware=dell-xps-9350-intel
fi
case "${image_hardware}" in
	generic-x86_64) ;;
	*) echo "Unsupported Finite image hardware: ${image_hardware}" >&2; false ;;
esac

# Only fresh selection negotiates a writer; saved profiles retain their schema.
jq -e --argjson helper "$capabilities" --arg foundation "$foundation" --arg hardware "$hardware" "$capability_filter"'
  . as $catalog |
  (.profileCapabilities.writeSchema // 2) as $writer |
  ($writer == 2 or $writer == 3) and
  (if has("profileSchema") then .profileSchema == $writer else true end) and
  ($helper.catalogSchemas | index($catalog.schema) != null) and
  ($helper.initializeSchemas | index($writer) != null) and
  ($helper.normalizeSchemas | index($writer) != null) and
  (.foundations[$foundation].hardware | index($hardware) != null) and
  (.roles | type == "object") and
  all(.roles | to_entries[];
    (.key | test("^[a-z][a-z0-9-]*$")) and
    (.value.label | type == "string") and (.value.order | type == "number") and
    (.value.classification == null or
      (.value.classification as $id | $catalog.classifications[$id].label | type == "string"))) and
  (if has("profileCapabilities") then
    (.profileCapabilities | valid_capabilities) and
    (.profileCapabilities.catalogSchemas | index($catalog.schema) != null) and
    (.profileCapabilities.normalizeSchemas | index($writer) != null) and
    (.profileCapabilities.initializeSchemas | index($writer) != null)
   else true end)
' "$catalog" >/dev/null || { echo "Incompatible Home Manager profile catalog or helper" >&2; false; }
writer_schema=$(jq -er '.profileCapabilities.writeSchema // 2' "$catalog")
role_rows=()
mapfile -d '' -t role_rows < <(jq -j '
  . as $catalog | .roles | to_entries | sort_by(.value.order, .key)[] |
  "FALSE", "\u0000", (if .value.classification == null then "" else $catalog.classifications[.value.classification].label end), "\u0000",
  .value.label, "\u0000", .key, "\u0000"
' "$catalog")
if ! roles=$(zenity --list --checklist \
	--title='Configure Finite' \
	--text='Select any roles for your Home Manager environment. Leaving every role unchecked installs the base environment.' \
	--column='Use' --column='Classification' --column='Role' --column='id' --hide-column=4 --print-column=4 --separator=, \
	"${role_rows[@]}"); then
	trap - ERR
	exit 0
fi

generated=$(mktemp)
trap 'rm -f -- "$generated"' EXIT
jq -n \
	--argjson schema "$writer_schema" \
	--arg foundation "$foundation" \
	--arg hardware "$hardware" \
	--arg roles "$roles" \
	'{schema: $schema, foundation: $foundation, hardware: $hardware, packages: [],
    roles: (if $roles == "" then [] else ($roles | split(",")) end), identity: {}} |
    if $schema == 3 then . + {capabilities: []} else . end' \
	>"$generated"
initialize_profile "$generated"
