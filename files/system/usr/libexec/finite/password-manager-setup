#!/usr/bin/python3
"""Explicit administrator installation of a reviewed 1Password browser wrapper.

The requirement describes immutable artifacts; it is not authorization. Each
installation also needs literal administrator-approved identities on the command
line. This utility never runs a setup script supplied by a home generation.
"""
import argparse
import contextlib
import fcntl
import grp
import hashlib
import json
import os
from pathlib import Path
import re
import shutil
import stat
import subprocess
import sys
import tempfile


STORE = Path('/nix/store')
STATE = Path('/var/lib/finite/password-managers/1password')
NIX_STORE = '/nix/var/nix/profiles/default/bin/nix-store'
RESTORECON = '/usr/sbin/restorecon'
GROUPADD = '/usr/sbin/groupadd'
MAX_JSON = 16384
STORE_NAME = re.compile(r'[0123456789abcdfghijklmnpqrsvwxyz]{32}-[A-Za-z0-9+._?=-]+')
DIGEST = re.compile(r'[0-9a-f]{64}')
FIELDS = {'schema', 'manager', 'package', 'helper', 'helperSha256',
          'wrapper', 'wrapperSha256', 'hostPath'}


class SetupError(ValueError):
    pass


def canonical_path(value):
    if not isinstance(value, str) or not value.startswith('/') or str(Path(value)) != value:
        raise SetupError('Expected a canonical absolute path')
    if any(part in ('.', '..') for part in value.split('/')):
        raise SetupError('Path traversal is not allowed')
    return Path(value)


def file_hash(fd):
    os.lseek(fd, 0, os.SEEK_SET)
    digest = hashlib.sha256()
    while chunk := os.read(fd, 1024 * 1024):
        digest.update(chunk)
    os.lseek(fd, 0, os.SEEK_SET)
    return digest.hexdigest()


def sync_directory(path):
    fd = os.open(path, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC)
    try:
        os.fsync(fd)
    finally:
        os.close(fd)


class Installer:
    def __init__(self, *, store_root=STORE, state_root=STATE, state_anchor=Path('/var/lib'),
                 trusted_uid=0, effective_uid=os.geteuid, run=subprocess.run,
                 group_lookup=grp.getgrnam):
        # Dependency injection is for hermetic tests, never exposed as CLI flags
        # or environment variables that could weaken the production checks.
        self.store = Path(store_root)
        self.state = Path(state_root)
        self.anchor = Path(state_anchor)
        self.uid = trusted_uid
        self.effective_uid = effective_uid
        self.run = run
        self.group_lookup = group_lookup

    def require_root(self):
        if self.effective_uid() != 0:
            raise SetupError('Administrator privileges are required')

    def trusted(self, path, *, directory=False, sticky_store=False):
        info = path.lstat()
        expected = ((lambda mode: stat.S_ISDIR(mode) or stat.S_ISREG(mode))
                    if directory is None else stat.S_ISDIR if directory else stat.S_ISREG)
        if not expected(info.st_mode) or info.st_uid != self.uid:
            raise SetupError(f'Unsafe ownership or file type: {path}')
        writable = info.st_mode & 0o022
        # Nix normally makes the store itself group-writable and sticky. All
        # approved objects below it must still be administrator-owned/read-only
        # to other users; sticky ownership protects their directory entries.
        if writable and not (sticky_store and info.st_mode & stat.S_ISVTX):
            raise SetupError(f'Path is writable by non-administrators: {path}')
        return info

    def object_path(self, value):
        path = canonical_path(value)
        try:
            parts = path.relative_to(self.store).parts
        except ValueError as error:
            raise SetupError('Artifact is outside the Nix store') from error
        if not parts or not STORE_NAME.fullmatch(parts[0]):
            raise SetupError('Invalid immutable Nix store object')
        self.trusted(self.store.parent, directory=True)
        self.trusted(self.store, directory=True, sticky_store=True)
        current = self.store
        for index, part in enumerate(parts):
            current /= part
            # A complete store output can itself be a regular file (writeText),
            # not only a directory. The caller enforces its expected leaf type.
            self.trusted(current, directory=True if index < len(parts) - 1 else None)
        return path, self.store / parts[0]

    def resolve_alias(self, path):
        # Wrapped packages can have a share/ symlink to their underlying package.
        # Follow only administrator-owned links that remain inside the store.
        path = Path(path)
        for _ in range(40):
            parts = path.relative_to(self.store).parts
            current = self.store
            for index, part in enumerate(parts):
                current /= part
                info = current.lstat()
                if stat.S_ISLNK(info.st_mode):
                    if info.st_uid != self.uid:
                        raise SetupError('Untrusted package symlink')
                    target = Path(os.readlink(current))
                    if not target.is_absolute():
                        target = current.parent / target
                    target = Path(os.path.normpath(target))
                    if not target.is_relative_to(self.store):
                        raise SetupError('Package symlink escapes the Nix store')
                    path = target.joinpath(*parts[index + 1:])
                    break
                self.trusted(current, directory=index < len(parts) - 1)
            else:
                return path
        raise SetupError('Too many package symlinks')

    @contextlib.contextmanager
    def open_artifact(self, value, *, limit=None):
        path, _ = self.object_path(value)
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC)
        try:
            info = os.fstat(fd)
            if not stat.S_ISREG(info.st_mode) or info.st_uid != self.uid or info.st_mode & 0o022:
                raise SetupError('Untrusted artifact descriptor')
            if limit is not None and info.st_size > limit:
                raise SetupError('Requirement exceeds the size limit')
            yield fd
        finally:
            os.close(fd)

    def requirement(self, path):
        with self.open_artifact(str(path), limit=MAX_JSON) as fd:
            raw = os.read(fd, MAX_JSON + 1)
        try:
            def unique_object(pairs):
                result = {}
                for key, value in pairs:
                    if key in result:
                        raise SetupError('Duplicate requirement field')
                    result[key] = value
                return result
            value = json.loads(raw, object_pairs_hook=unique_object)
        except (UnicodeError, json.JSONDecodeError) as error:
            raise SetupError('Invalid requirement JSON') from error
        if not isinstance(value, dict) or set(value) != FIELDS:
            raise SetupError('Unsupported requirement fields')
        if type(value['schema']) is not int or value['schema'] != 1 or value['manager'] != '1password':
            raise SetupError('Unsupported password-manager requirement')
        for key in ('helperSha256', 'wrapperSha256'):
            if not isinstance(value[key], str) or not DIGEST.fullmatch(value[key]):
                raise SetupError('Invalid artifact SHA-256')
        package, package_root = self.object_path(value['package'])
        helper, helper_root = self.object_path(value['helper'])
        wrapper, wrapper_root = self.object_path(value['wrapper'])
        if package != package_root or not package.is_dir():
            raise SetupError('Package must be a complete Nix store output')
        if helper != helper_root / 'share/1password/1Password-BrowserSupport':
            raise SetupError('Unexpected 1Password helper layout')
        if wrapper != wrapper_root / 'bin/1Password-BrowserSupport':
            raise SetupError('Unexpected security-wrapper layout')
        if self.resolve_alias(package / 'share/1password/1Password-BrowserSupport') != helper:
            raise SetupError('Package and helper do not match')
        expected = self.state / wrapper_root.name / '1Password-BrowserSupport'
        if canonical_path(value['hostPath']) != expected:
            raise SetupError('Unexpected host installation path')
        return value

    @contextlib.contextmanager
    def sources(self, requirement):
        with self.open_artifact(requirement['helper']) as helper, \
                self.open_artifact(requirement['wrapper']) as wrapper:
            for key, fd in (('helper', helper), ('wrapper', wrapper)):
                if file_hash(fd) != requirement[key + 'Sha256']:
                    raise SetupError(f'{key} hash differs from the approved requirement')
                if not os.fstat(fd).st_mode & 0o111 or os.read(fd, 4) != b'\x7fELF':
                    raise SetupError(f'{key} must be a native ELF executable')
                os.lseek(fd, 0, os.SEEK_SET)
            # This confirms artifact consistency, not executable provenance.
            # Explicit approval of BOTH literal hashes is still required.
            targets = [(str(Path(requirement['package']) / 'share/1password/1Password-BrowserSupport')).encode() + b'\0',
                       requirement['helper'].encode() + b'\0']
            tail, found = b'', False
            while chunk := os.read(wrapper, 1024 * 1024):
                data = tail + chunk
                found |= any(target in data for target in targets)
                tail = data[-max(map(len, targets)):]
            os.lseek(wrapper, 0, os.SEEK_SET)
            if not found:
                raise SetupError('Wrapper does not reference the selected fixed helper target')
            yield helper, wrapper

    def command(self, argv):
        result = self.run(argv, check=True, text=True, capture_output=True, timeout=60,
                          env={'PATH': '/usr/sbin:/usr/bin:/sbin:/bin', 'HOME': '/root',
                               'LANG': 'C', 'LC_ALL': 'C'})
        if len(result.stdout or '') > 2 * 1024 * 1024:
            raise SetupError('Oversized system command response')
        return result.stdout or ''

    def directory(self, path):
        if not path.is_relative_to(self.anchor):
            raise SetupError('State directory escapes its fixed anchor')
        self.trusted(self.anchor, directory=True)
        current = self.anchor
        for part in path.relative_to(self.anchor).parts:
            current /= part
            try:
                current.mkdir(mode=0o755)
            except FileExistsError:
                pass
            self.trusted(current, directory=True)

    @contextlib.contextmanager
    def locked(self):
        self.directory(self.state)
        fd = os.open(self.state / '.lock', os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600)
        try:
            info = os.fstat(fd)
            if not stat.S_ISREG(info.st_mode) or info.st_uid != self.uid or info.st_mode & 0o077:
                raise SetupError('Unsafe installation lock')
            fcntl.flock(fd, fcntl.LOCK_EX)
            yield
        finally:
            os.close(fd)

    def group(self):
        try:
            group = self.group_lookup('onepassword')
        except KeyError:
            self.command([GROUPADD, '--system', 'onepassword'])
            group = self.group_lookup('onepassword')
        if group.gr_gid <= 0:
            raise SetupError('The onepassword identity group must not be root')
        return group.gr_gid

    def status(self, requirement):
        destination = Path(requirement['hostPath'])
        version = destination.parent
        if not version.exists() and not version.is_symlink():
            return {'installed': False, 'hostPath': str(destination)}
        # Read-only: status never creates state, locks, groups or GC roots.
        current = self.anchor
        self.trusted(current, directory=True)
        for part in version.relative_to(self.anchor).parts:
            current /= part
            self.trusted(current, directory=True)
        info = self.trusted(destination)
        if stat.S_IMODE(info.st_mode) != 0o2755 or info.st_gid != self.group_lookup('onepassword').gr_gid:
            raise SetupError('Installed wrapper permissions or group differ')
        receipt = version / 'receipt.json'
        self.trusted(receipt)
        if receipt.stat().st_size > MAX_JSON or json.loads(receipt.read_text()) != requirement:
            raise SetupError('Installed receipt differs from the selected requirement')
        with destination.open('rb') as stream:
            if hashlib.file_digest(stream, 'sha256').hexdigest() != requirement['wrapperSha256']:
                raise SetupError('Installed wrapper hash differs')
        roots = self.state / '.roots' / version.name
        current = self.state
        for part in roots.relative_to(self.state).parts:
            current /= part
            self.trusted(current, directory=True)
        for label, source in self.root_sources(requirement).items():
            root = roots / label
            if not root.is_symlink() or Path(os.readlink(root)) != source:
                raise SetupError('Installed helper closure root is missing or differs')
        return {'installed': True, 'hostPath': str(destination)}

    def root_sources(self, requirement):
        return {key: self.object_path(requirement[key])[1] for key in ('package', 'helper', 'wrapper')}

    def install(self, requirement, *, approve_package, approve_helper_sha256, approve_wrapper_sha256):
        self.require_root()
        if (approve_package != requirement['package']
                or approve_helper_sha256 != requirement['helperSha256']
                or approve_wrapper_sha256 != requirement['wrapperSha256']):
            raise SetupError('Literal administrator approvals do not match the exact package and hashes')
        with self.sources(requirement) as (helper_fd, wrapper_fd), self.locked():
            if self.status(requirement)['installed']:
                return self.status(requirement)
            gid = self.group()
            destination = Path(requirement['hostPath'])
            roots = self.state / '.roots' / destination.parent.name
            roots_existed = roots.exists() or roots.is_symlink()
            self.directory(roots)
            stage = Path(tempfile.mkdtemp(prefix='.install-', dir=self.state))
            published, created_roots = False, []
            try:
                for label, source in self.root_sources(requirement).items():
                    root = roots / label
                    if root.exists() or root.is_symlink():
                        raise SetupError('Unreceipted closure root already exists')
                    created_roots.append(root)
                    self.command([NIX_STORE, '--add-root', str(root), '--indirect', '--realise', str(source)])
                    if not root.is_symlink() or Path(os.readlink(root)) != source:
                        raise SetupError('Nix did not establish the requested closure root')
                for value, fd in ((requirement['helper'], helper_fd), (requirement['wrapper'], wrapper_fd)):
                    pinned, current = os.fstat(fd), os.stat(value, follow_symlinks=False)
                    if (pinned.st_dev, pinned.st_ino) != (current.st_dev, current.st_ino):
                        raise SetupError('Artifact changed while establishing closure roots')
                if (file_hash(helper_fd) != requirement['helperSha256']
                        or file_hash(wrapper_fd) != requirement['wrapperSha256']):
                    raise SetupError('Artifact content changed while establishing closure roots')
                target = stage / destination.name
                output = os.open(target, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
                try:
                    os.lseek(wrapper_fd, 0, os.SEEK_SET)
                    while chunk := os.read(wrapper_fd, 1024 * 1024):
                        view = memoryview(chunk)
                        while view:
                            view = view[os.write(output, view):]
                    os.fchown(output, self.uid, gid)
                    os.fchmod(output, 0o2755)
                    os.fsync(output)
                finally:
                    os.close(output)
                receipt = stage / 'receipt.json'
                with receipt.open('x') as stream:
                    stream.write(json.dumps(requirement, indent=2, sort_keys=True) + '\n')
                    os.fchmod(stream.fileno(), 0o644)
                    stream.flush()
                    os.fsync(stream.fileno())
                stage.chmod(0o755)
                sync_directory(stage)
                os.rename(stage, destination.parent)
                published = True
                sync_directory(self.state)
                self.command([RESTORECON, '-RF', str(destination.parent)])
                return self.status(requirement)
            except BaseException:
                if published:
                    shutil.rmtree(destination.parent)
                else:
                    shutil.rmtree(stage)
                for root in created_roots:
                    root.unlink(missing_ok=True)
                if not roots_existed:
                    roots.rmdir()
                raise

    def remove(self, requirement, *, approve_wrapper_sha256):
        self.require_root()
        if approve_wrapper_sha256 != requirement['wrapperSha256']:
            raise SetupError('Removal requires literal approval of this wrapper hash')
        with self.locked():
            if not self.status(requirement)['installed']:
                return {'installed': False}
            version = Path(requirement['hostPath']).parent
            roots = self.state / '.roots' / version.name
            for source in set(self.root_sources(requirement).values()):
                referrers = self.command([NIX_STORE, '--query', '--referrers-closure', str(source)]).splitlines()
                if any(path.endswith('-home-manager-generation') for path in referrers):
                    raise SetupError('A Home Manager generation still refers to this helper; retain it for rollback')
                for row in self.command([NIX_STORE, '--query', '--roots', str(source)]).splitlines():
                    name = row.split(' -> ', 1)[0]
                    if not name.startswith('/'):
                        raise SetupError('Unrecognized GC-root output; preserving the helper')
                    root = Path(name)
                    indirect = Path(os.readlink(root)) if root.is_symlink() else None
                    if not root.is_relative_to(roots) and not (indirect and indirect.is_relative_to(roots)):
                        raise SetupError('An external GC root still requires this helper')
            if set(p.name for p in version.iterdir()) != {'1Password-BrowserSupport', 'receipt.json'}:
                raise SetupError('Version directory contains unrecognized administrator files')
            Path(requirement['hostPath']).unlink()
            (version / 'receipt.json').unlink()
            version.rmdir()
            for label in self.root_sources(requirement):
                (roots / label).unlink()
            roots.rmdir()
            sync_directory(self.state)
            return {'installed': False}


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    sub = parser.add_subparsers(dest='operation', required=True)
    for operation in ('inspect', 'install', 'status', 'remove'):
        command = sub.add_parser(operation)
        command.add_argument('--requirement', required=True)
        if operation == 'install':
            command.add_argument('--approve-package', required=True)
            command.add_argument('--approve-helper-sha256', required=True)
        if operation in ('install', 'remove'):
            command.add_argument('--approve-wrapper-sha256', required=True)
    args = parser.parse_args(argv)
    installer = Installer()
    try:
        if args.operation in ('install', 'remove'):
            installer.require_root()
        requirement = installer.requirement(args.requirement)
        if args.operation == 'inspect':
            with installer.sources(requirement):
                result = requirement
        elif args.operation == 'install':
            result = installer.install(requirement, approve_package=args.approve_package,
                                       approve_helper_sha256=args.approve_helper_sha256,
                                       approve_wrapper_sha256=args.approve_wrapper_sha256)
        elif args.operation == 'remove':
            result = installer.remove(requirement, approve_wrapper_sha256=args.approve_wrapper_sha256)
        else:
            result = installer.status(requirement)
        print(json.dumps(result, sort_keys=True))
        return 1 if args.operation == 'status' and not result['installed'] else 0
    except (OSError, ValueError, KeyError, subprocess.SubprocessError) as error:
        print(f'Password-manager setup: {error}', file=sys.stderr)
        return 2


if __name__ == '__main__':
    sys.exit(main())
