ARG INSTALLER
FROM ${INSTALLER}
COPY install_finite_fstab /build-container-installer/lorax_templates/scripts/post/install_finite_fstab
COPY secure-boot.der /build-container-installer/sb_pubkey.der
# Make's existing sb_pubkey.der target now resolves locally. If the bytes are
# removed, fail rather than following the upstream mutable network URL.
RUN grep -Fq 'curl --fail -L -o sb_pubkey.der $(SECURE_BOOT_KEY_URL)' /build-container-installer/Makefile \
    && sed -i 's|curl --fail -L -o sb_pubkey.der $(SECURE_BOOT_KEY_URL)|echo "Pinned Secure Boot certificate missing" >\&2; exit 1|' /build-container-installer/Makefile
